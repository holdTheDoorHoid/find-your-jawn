---
import QuizApp from '../islands/quiz/QuizApp';
import CheckIn from '../components/CheckIn.astro';
import Base from '../layouts/Base.astro';
import { loadGroups } from '../lib/data';
import { withBase } from '../lib/site';
import { match as t, paths, quiz } from '../strings/en';

const { built } = loadGroups();
---

<Base title={t.title} description={t.metaDescription} path="match/">
  <div class="page">
    <div class="wrap">
      <h1>{t.heading}</h1>
      <p class="lede">{t.lede}</p>
      <p class="help">{t.privateLine}</p>

      <CheckIn />

      <section id="quiz-root" aria-label={t.mountLabel}>
        <QuizApp client:only="preact" dataVersion={built}>
          <p slot="fallback" role="status">{quiz.loading}</p>
        </QuizApp>
        <noscript><p class="callout">{t.noscript}</p></noscript>
      </section>

      <h2>{t.meanwhile}</h2>
      <ul>
        <li><a href={withBase('browse/')}>{t.browse}</a></li>
        {[paths.serviceHours, paths.courtOrdered, paths.families, paths.newToPhilly].map((g) => <li><a href={withBase(`paths/${g.slug}/`)}>{g.title}</a></li>)}
        <li><a href={withBase('how-ranking-works/')}>{t.how}</a></li>
      </ul>
    </div>
  </div>
</Base>
