---
import MyListApp from '../islands/MyListApp';
import Base from '../layouts/Base.astro';
import { makeBrowseConfig } from '../lib/browse-config';
import { loadGroups, loadVocab } from '../lib/data';
import { browse, myList as t } from '../strings/en';

const { groups, built } = loadGroups();
const config = makeBrowseConfig(groups, loadVocab(), built);
---

<Base title={t.title} description={t.metaDescription} path="my-list/" noindex>
  <div class="page">
    <div class="wrap">
      <h1>{t.title}</h1>
      <p class="lede">{t.intro}</p>
      <MyListApp client:only="preact" dataVersion={config.dataVersion} places={config.places}>
        <p slot="fallback" role="status">{t.loading}</p>
      </MyListApp>
      <noscript><p class="callout">{browse.noscript}</p></noscript>
    </div>
  </div>
</Base>
