---
import { inline } from '../lib/inline';
import { basePath } from '../lib/site';
import type { Block } from '../strings/en';

interface Props {
  blocks: Block[];
  /** first heading level to use for { h }, default 2 */
  class?: string;
}
const { blocks, class: className = 'prose' } = Astro.props;
const base = basePath();
const html = (s: string) => inline(s, base);
---

<div class={className}>
  {
    blocks.map((b) => {
      if ('h' in b) return <h2 set:html={html(b.h)} />;
      if ('h3' in b) return <h3 set:html={html(b.h3)} />;
      if ('p' in b) return <p set:html={html(b.p)} />;
      if ('ul' in b) return <ul>{b.ul.map((li) => <li set:html={html(li)} />)}</ul>;
      if ('ol' in b) return <ol>{b.ol.map((li) => <li set:html={html(li)} />)}</ol>;
      return <div class="callout"><p set:html={html(b.note)} /></div>;
    })
  }
</div>
