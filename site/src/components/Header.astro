---
import { withBase } from '../lib/site';
import { nav, notice, site } from '../strings/en';

interface Props {
  /** the site is showing made up sample data */
  sample?: boolean;
}
const { sample = false } = Astro.props;
const here = Astro.url.pathname;
const items = [
  { href: withBase('match/'), label: nav.match },
  { href: withBase('browse/'), label: nav.browse },
  { href: withBase('support/'), label: nav.support },
  { href: withBase('my-list/'), label: nav.myList },
];
const isHere = (href: string) => here === href || here === href.replace(/\/$/, '');
---

<header class="site-header">
  {
    sample && (
      <div class="notice notice--sample" role="note">
        <div class="wrap-wide">
          <p><strong>{notice.fixtureTitle}</strong> {notice.fixtureText}</p>
        </div>
      </div>
    )
  }
  <div class="notice" role="note">
    <div class="wrap-wide">
      <p><strong>{notice.title}</strong> {notice.text}</p>
    </div>
  </div>
  <div class="wrap-wide header-bar">
    <a class="wordmark" href={withBase('')} aria-label={site.homeLabel}>Find Your<span>Jawn</span></a>
    <nav class="main-nav" aria-label={nav.label}>
      <ul>
        {
          items.map((i) => (
            <li>
              <a href={i.href} aria-current={isHere(i.href) ? 'page' : undefined}>{i.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
